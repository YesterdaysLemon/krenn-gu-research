# Python
__pycache__/
*.pyc

# Scratch space (kept on disk for reference, never committed)
tmp/
.claude/

# Solver run inputs and outputs (regenerable from the Python generators)
*.sing
*.ms
*.out
*.stdout
*.log
*.result

# SAT/proof artifacts (regenerable; replay packages keep manifests only)
*.cnf
*.drat

# Brute-force CEGAR state and catalogue dumps (produced by package_*.py)
research_snapshots/*/states/
*_cegar_state.json
sat_catalogue*.json
*_core_charts.json
fresh_singular_replay.json
q5_311_zero_forest_seeds*.json
rare_support_cover.json
zero_forest_records.json
rare_zero_probe.json
focused_ledger.json
audit_c10.json
audit_c4c6.json
degree_one_macaulay_certificates.json

# Per-project generated intermediates (long-standing rules)
*_candidate*.json
search_seed_*_best.json
weighted_seed_*_best.json
killer_*.json
prism_stratum*.json
prism_*.sing
*_orbits.json
triangle_support*.json
